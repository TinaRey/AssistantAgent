# ---- Backend ----
# `production` makes the app refuse to start unless APP_PASSWORD, SECRET_KEY, INTERNAL_API_KEY,
# COOKIE_SECURE=true and DATABASE_URL are all set (see docs/deployment.md). Leave `development` locally.
ENVIRONMENT=development
# Shared secret between the frontend proxy and the backend (>= 32 chars). Empty locally = no gate.
# Production: same value on both services. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=
# Required from Phase 1 (chat). Not needed to boot the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Password to open the app. Login is refused while empty.
APP_PASSWORD=
# Signs session cookies. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set true when served over HTTPS (production)
COOKIE_SECURE=false
# Postgres. Local Docker shown; Supabase/Render URLs (postgres:// or postgresql://) are accepted as is.
DATABASE_URL=postgresql+psycopg://pantalelle:pantalelle@localhost:5432/pantalelle
# Tavily API key (https://app.tavily.com). Empty = search disabled (mock returns nothing).
SEARCH_API_KEY=

# ---- Frontend ----
# Where the Next.js server proxies /api/* (read at runtime, never sent to the browser)
BACKEND_URL=http://localhost:8000

# Image generation (OpenAI): only on explicit user request, every image is billed.
# IMAGE_COST_ESTIMATE_USD is only the indicative price shown next to the button.
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1024
MAX_IMAGES_PER_PRESENTATION=6
IMAGE_COST_ESTIMATE_USD=0.05
