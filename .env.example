# ---- Backend ----
# Required from Phase 1 (chat). Not needed to boot the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Shared password protecting the private app (enforced from Phase 1)
APP_PASSWORD=
# Postgres (introduced in Phase 2)
DATABASE_URL=postgresql+psycopg://pantallele:pantallele@localhost:5432/pantallele
# Web search provider key (Phase 4)
SEARCH_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
